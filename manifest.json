{
  "schema": 1,
  "id": "valet-search-firecrawl",
  "name": "Firecrawl Search",
  "version": "0.1.0",
  "description": "web_search_firecrawl and web_fetch_firecrawl tools backed by the Firecrawl API (works without a key).",
  "repository": "https://github.com/valethq/valet-search-firecrawl",
  "valet": "^0.1.0",
  "main": "./src/index.ts",
  "provides": ["tools@1", "settings@1"],
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "secret": {
        "type": "string"
      },
      "baseUrl": {
        "type": "string"
      },
      "mode": {
        "type": "string",
        "enum": ["web", "news"]
      },
      "numResults": {
        "type": "number"
      },
      "maxCharacters": {
        "type": "number"
      },
      "timeoutMs": {
        "type": "number"
      },
      "minRole": {
        "type": "string",
        "enum": ["owner", "trusted", "guest"]
      }
    }
  }
}
